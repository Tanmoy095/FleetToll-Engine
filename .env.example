# The Go services read these variables from their process environment.
# Export them in the shell before starting services; they do not load .env files.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=obudata
KAFKA_CONSUMER_GROUP=fleettoll-distance-calculator
DATABASE_URL=postgres://fleettoll:fleetdev@localhost:15432/fleettoll?sslmode=disable

# Used only by `make integration-kafka`.
KAFKA_TEST_BROKERS=localhost:9092
DATABASE_TEST_URL=postgres://fleettoll:fleetdev@localhost:15432/fleettoll?sslmode=disable
